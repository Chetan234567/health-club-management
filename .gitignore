# ==========================================
# Java / Spring Boot (Backend)
# ==========================================
# Compiled class files
*.class

# Log files
*.log

# Package Files (JAR, WAR, EAR)
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# Target folder (Maven output)
target/
*.sdkmanrc

# Application configuration overrides (keeps secrets/passwords safe)
application-local.properties
application-local.yml
application-dev.properties

# ==========================================
# React / Node.js (Frontend)
# ==========================================
# Dependencies
node_modules/
/.pnp
.pnp.js

# Production build output
dist/
build/

# Environment variables (keeps API keys and local configs private)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# npm / yarn / pnpm debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace